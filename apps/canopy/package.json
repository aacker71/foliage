{
  "name": "@foliage/canopy-app",
  "license": "MIT",
  "version": "0.0.0",
  "description": "The public Canopy web surface. Static-first, using the shared server-rendered Leaf surface.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "manage": "node manage-server.mjs",
    "import:source": "node import-source.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p workspace-ui/tsconfig.json",
    "workspace:build": "bun workspace-ui/build.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@foliage/canopy": "workspace:*",
    "@foliage/dashboard-app": "workspace:*",
    "@foliage/leaf": "workspace:*",
    "@foliage/leaf-app": "workspace:*",
    "@foliage/photosynthesis": "workspace:*",
    "@foliage/tokens": "workspace:*",
    "@foliage/ui": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "docx": "9.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jszip": "3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": "22.x"
  }
}
