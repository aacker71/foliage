# Canopy Cloud reads a local Compound Leaf and writes public artifacts into a separate directory.
# These are paths, not secrets. Do not rename this file to a tracked .env file.
FOLIAGE_LEAF=/absolute/path/to/leaf.json
FOLIAGE_POLICY=/absolute/path/to/policy.json
FOLIAGE_PUBLISHED=/absolute/path/to/published

# The manager may bind only to a loopback address. Its public link points at the read-only server.
HOST=127.0.0.1
PORT=4180
FOLIAGE_PUBLIC_ORIGIN=http://127.0.0.1:4173

# Optional Ladybug private workspace. Keep OUTSIDE FOLIAGE_PUBLISHED.
# Defaults to ladybug.json beside FOLIAGE_LEAF. Do not commit actual packets or responses.
FOLIAGE_LADYBUG=/absolute/path/to/private/ladybug.json

# Fireworks assessment is disabled until all three settings are supplied.
# The exact Kimi model/router id must be confirmed in your Fireworks account; no fallback model.
FOLIAGE_ESCALATED_INFERENCE_MODEL=
FOLIAGE_ESCALATED_INFERENCE_KEY=
# Set true only after checking the account's US processing/residency and retention agreement.
# This flag records operator approval; it does not prove residency or provider retention.
FOLIAGE_ASSESSMENT_PROVIDER_APPROVED=false

# Optional local-device handoff to a separately deployed Canopy service.
# Exact HTTPS origin; disabled while blank. Credentials are entered locally, never here.
FOLIAGE_HOSTED_ORIGIN=
FOLIAGE_HOSTED_STATE=/absolute/path/to/private/hosted/connection.json

# Hosted Vercel entry (hosted-server.mjs), separate from the loopback manager above.
# Set these in the Canopy project's Preview environment, using a dedicated preview
# Supabase project. Blank values deliberately refuse startup. Never paste real keys here.
# Use one stable exact HTTPS preview origin; no trailing slash, path or wildcard.
# Clerk SSO uses this exact application origin; public readers never load Clerk.
FOLIAGE_APP_ORIGIN=
SUPABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Apply the isolated project's migrations before exercising publication. Its
# foliage-publications bucket must remain private. Notification setup is separate;
# leave every NOVU_* variable unset until the Clerk contact adapter is implemented.

# Optional native Merge ATS setup. Leave both variables UNSET to disable it.
# Server-only key; choose the region belonging to your Merge organization: us, eu, or ap.
# Configure approved ATS scopes in Merge first. Setup disables candidate sync and sends no resume.
# MERGE_API_KEY=
# MERGE_REGION=
