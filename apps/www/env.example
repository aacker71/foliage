# Set only reviewed production destinations. No localhost links are emitted in production.
# FOLIAGE_SITE_ORIGIN=https://your-website-origin
# FOLIAGE_HOSTED_ORIGIN=https://your-canopy-origin
# Set only after live sign-in, storage and owner-isolation acceptance is recorded.
# FOLIAGE_HOSTED_ACCEPTED=1
# The bundled macOS archive is the default same-origin download.
# To replace it with an externally hosted verified release, set all three fields together.
# FOLIAGE_DOWNLOAD_URL=https://your-distribution-origin/foliage-local.tgz
# FOLIAGE_DOWNLOAD_SHA256=<64 lowercase hexadecimal characters>
# FOLIAGE_RELEASE_VERSION=0.1.0-rc.1

# Optional restricted review environment, shown explicitly as a preview.
# FOLIAGE_PREVIEW_ORIGIN=https://your-preview-origin
